<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Required (targetSdk 34+) to run geolocator_android's bundled
         GeolocatorLocationService as a real foreground service during an
         active clock-in session (see LocationService.startTracking) -
         without these, starting it throws a SecurityException on
         Android 14+. The plugin's own manifest declares the <service> and
         its foregroundServiceType="location", but not these permissions -
         apps are expected to add them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required for ForegroundNotificationConfig.enableWakeLock, so the
         CPU stays awake enough for polling to keep its normal cadence
         while the screen is locked during an active session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Native background tracking engine (com.mikappliance.outletManager.location) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Confirmed by device testing: without an exemption, Doze/App Standby
         (and this device's own OEM battery management) can block delivery
         of BOOT_COMPLETED and other broadcasts outright, regardless of the
         manifest otherwise being correct. Google Play restricts this
         permission to apps with genuine ongoing background work, which a
         field-agent location-tracking app qualifies for — see
         location_permission_screen.dart for where the user-facing prompt
         triggering it lives. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Runtime permission on Android 10+ (API 29), requested from
         location_permission_screen.dart alongside the battery exemption.
         Lets LocationTrackingService widen its ping interval while
         Activity Recognition confirms the device is STILL — absence is a
         safe no-op (see LocationTrackingService.startMotionUpdates). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Camera permission for barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- FCM: show notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- open_filex declares these unconditionally to open arbitrary file
         types, but this app only uses it to open a PDF it just generated
         via FileProvider — that needs no media-store read access. Photo
         attachment (image_picker) already uses the system Photo Picker,
         which also needs none of these. Removed so Play's photo/video
         permission policy doesn't flag them as unjustified broad access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    
    <application
        android:label="Outlet Manager"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FCM default notification channel for Android 8+ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general_notifications" />

        <!-- Native background tracking engine — see
             android/app/src/main/kotlin/.../location/ and the Phase 1 plan
             this implements. Owns the tracking lifecycle independently of
             the Flutter Activity/engine.

             android:directBootAware="true" on both: confirmed by device
             testing that BOOT_COMPLETED can arrive before the user's first
             unlock after a reboot. Without this, Android defers delivering
             the broadcast to BootReceiver at all until after unlock — so a
             reboot mid-shift would silently leave tracking stopped until
             the agent happened to reopen the app themselves. TrackingStateStore
             and LocationQueueDb live in Device Protected storage precisely
             so this actually works pre-unlock (see deviceProtectedContext). -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="location" />
        <receiver
            android:name=".location.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Target of LocationTrackingService's Activity Recognition
             PendingIntent — not launched via an intent-filter, only by that
             explicit PendingIntent, so exported="false" is correct. -->
        <receiver
            android:name=".location.MotionTransitionReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
