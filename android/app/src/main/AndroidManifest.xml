<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Required (targetSdk 34+) to run geolocator_android's bundled
         GeolocatorLocationService as a real foreground service during an
         active clock-in session (see LocationService.startTracking) -
         without these, starting it throws a SecurityException on
         Android 14+. The plugin's own manifest declares the <service> and
         its foregroundServiceType="location", but not these permissions -
         apps are expected to add them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Required for ForegroundNotificationConfig.enableWakeLock, so the
         CPU stays awake enough for polling to keep its normal cadence
         while the screen is locked during an active session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Needed by flutter_background_geolocation's startOnBoot: true (see
         BackgroundGeolocationService.configure) — its own AAR registers a
         BootReceiver, but doesn't declare this permission itself, so the
         app must. Without it, BOOT_COMPLETED is never delivered and
         tracking silently stays off after a reboot mid-shift. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Backs BackgroundGeolocationService.requestBatteryOptimizationExemption
         (DeviceSettings.showIgnoreBatteryOptimizations) — confirmed by
         device testing this is required for that flow to work; the
         plugin's AAR doesn't declare it itself. Without an exemption,
         Doze/App Standby (and OEM battery management) can throttle
         background delivery outright. Google Play restricts this
         permission to apps with genuine ongoing background work, which a
         field-agent location-tracking app qualifies for — see
         location_permission_screen.dart for where the user-facing prompt
         triggering it lives. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Runtime permission on Android 10+ (API 29) — backs the plugin's own
         motion/activity-recognition authorization, requested as part of
         BackgroundGeolocationService.requestPermission() (see
         location_permission_screen.dart). Absence is a safe no-op: the
         plugin just never gets motion-aware cadence adjustments. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Camera permission for barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- FCM: show notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Backs TrackingReminderScheduler's reboot reminder: the full-screen
         alarm-style notification prompting the user to reopen the app
         after a reboot (see that class's doc comment for why this exists
         at all — the app is otherwise stuck at a background execution
         tier that can't reliably sustain tracking). Android 14+ still
         requires the user to separately grant this via
         MainActivity.requestFullScreenIntentPermission(); without it the
         notification just downgrades to a normal heads-up one. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets the reminder repeat on a precise 5-minute schedule via
         AlarmManager.setExactAndAllowWhileIdle. Requires the user to grant
         it via Settings on Android 12+ (not a runtime prompt dialog);
         TrackingReminderScheduler falls back to inexact scheduling if it
         isn't granted, so this is a best-effort precision improvement,
         not a hard requirement. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- open_filex declares these unconditionally to open arbitrary file
         types, but this app only uses it to open a PDF it just generated
         via FileProvider — that needs no media-store read access. Photo
         attachment (image_picker) already uses the system Photo Picker,
         which also needs none of these. Removed so Play's photo/video
         permission policy doesn't flag them as unjustified broad access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    
    <application
        android:label="Outlet Manager"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FCM default notification channel for Android 8+ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general_notifications" />

        <!-- flutter_background_geolocation (Transistorsoft) trial license —
             value comes from android/local.properties (gitignored) via
             the transistorsoftLicenseKey manifest placeholder set in
             android/app/build.gradle.kts. -->
        <meta-data
            android:name="com.transistorsoft.locationmanager.license"
            android:value="${transistorsoftLicenseKey}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- See TrackingReminderScheduler's doc comment. Exported: true
             is required for the system to deliver BOOT_COMPLETED — same
             pattern the flutter_background_geolocation plugin's own
             bundled BootReceiver uses. -->
        <receiver
            android:name=".reminder.RebootTrackingReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Only ever invoked via our own explicit PendingIntent from
             TrackingReminderScheduler — not exported. -->
        <receiver
            android:name=".reminder.TrackingReminderAlarmReceiver"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
