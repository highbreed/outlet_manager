      playSound: false,
      ongoing: true,
      autoCancel: false,
    );
  }

  /// Start countdown timer that updates persistent notification
  void startCountdownTimer({
    required String outletName,
    required Duration totalDuration,
  }) {
    _stopCountdownTimer(); // Stop any existing timer
    _gracePeriodStartTime = DateTime.now();

    _countdownTimer = Timer.periodic(const Duration(seconds: 5), (timer) {
      final elapsed = DateTime.now().difference(_gracePeriodStartTime!);
      final remaining = totalDuration - elapsed;

      if (remaining.isNegative || remaining.inSeconds <= 0) {
        _stopCountdownTimer();
        return;
      }

      showPersistentCountdown(outletName: outletName, remainingTime: remaining);
    });

    // Show initial notification immediately
    showPersistentCountdown(
      outletName: outletName,
      remainingTime: totalDuration,
    );
  }

  /// Stop countdown timer
  void _stopCountdownTimer() {
    _countdownTimer?.cancel();
    _countdownTimer = null;
    _gracePeriodStartTime = null;
  }

  /// Clear persistent notification
  Future<void> clearPersistentNotification() async {
    _stopCountdownTimer();
    await _plugin.cancel(_persistentNotificationId);
  }
